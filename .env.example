# Neon Managed Better Auth base URL (same value as snap-link's NEON_AUTH_BASE_URL)
VITE_NEON_AUTH_URL=https://ep-xxxxx.neonauth.region.aws.neon.tech/neondb/auth

# Where the dev server proxies API calls
VITE_API_PROXY_TARGET=http://127.0.0.1:8081

# Optional: API base path or absolute URL. Defaults to /api (proxied in dev).
# VITE_API_BASE=/api

# Origin the dev proxy sends to the auth service. Must be trusted in
# Neon Console → Branch → Auth → Trusted domains.
VITE_AUTH_ORIGIN=http://localhost:8081

# "proxy" = same-origin dev proxy (recommended)
# "direct" = call Neon Auth cross-origin (add http://localhost:5173 to trusted domains)
VITE_AUTH_MODE=proxy

# Optional: override the origin used when displaying/copying short links.
# Leave empty to use the link returned by snap-link (PUBLIC_BASE_URL).
VITE_SHORT_BASE_URL=http://localhost:8081
